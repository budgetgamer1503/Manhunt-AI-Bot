{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.manhunt_hunter": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.steve",
            "Texture.alex",
            "Texture.zombie",
            "Texture.skeleton",
            "Texture.creeper",
            "Texture.custom",
            "Texture.dream",
            "Texture.technoblade"
          ]
        },
        "geometries": {
          "Array.models": [
            "Geometry.steve",
            "Geometry.alex",
            "Geometry.steve",
            "Geometry.steve",
            "Geometry.steve",
            "Geometry.steve",
            "Geometry.steve",
            "Geometry.steve"
          ]
        }
      },
      "geometry": "Array.models[query.property('manhunt:skin_id')]",
      "materials": [
        {
          "*": "material.default"
        }
      ],
      "textures": [
        "Array.skins[query.property('manhunt:skin_id')]"
      ]
    },
    "controller.render.manhunt_path_node": {
      "geometry": "geometry.default",
      "materials": [
        {
          "*": "material.default"
        }
      ],
      "textures": [
        "texture.default"
      ]
    }
  }
}
